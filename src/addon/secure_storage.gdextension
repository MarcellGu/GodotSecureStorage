[configuration]

entry_symbol = "secure_storage_library_init"
compatibility_minimum = "4.7"
reloadable = false
android_aar_plugin = true

[libraries]

macos.debug = "res://addons/SecureStorage/bin/macos/libsecure_storage.macos.template_debug.framework"
macos.release = "res://addons/SecureStorage/bin/macos/libsecure_storage.macos.template_release.framework"
windows.debug.x86_64 = "res://addons/SecureStorage/bin/windows/secure_storage.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/SecureStorage/bin/windows/secure_storage.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/SecureStorage/bin/linux/libsecure_storage.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/SecureStorage/bin/linux/libsecure_storage.linux.template_release.x86_64.so"
android.debug.arm64 = "res://addons/SecureStorage/bin/android/arm64-v8a/libsecure_storage.so"
android.release.arm64 = "res://addons/SecureStorage/bin/android/arm64-v8a/libsecure_storage.so"
ios.debug = "res://addons/SecureStorage/bin/ios/libsecure_storage.ios.template_debug.xcframework"
ios.release = "res://addons/SecureStorage/bin/ios/libsecure_storage.ios.template_release.xcframework"

[dependencies]

ios.debug = {
    "res://addons/SecureStorage/bin/ios/libgodot-cpp.ios.template_debug.xcframework": ""
}
ios.release = {
    "res://addons/SecureStorage/bin/ios/libgodot-cpp.ios.template_release.xcframework": ""
}

[icons]

SecureStorage = "res://addons/SecureStorage/icon.svg"
