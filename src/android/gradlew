#!/bin/sh
set -eu

android_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(CDPATH= cd -- "$android_dir/.." && pwd)
gradle_version="8.14.3"
gradle_sha256="bd71102213493060956ec229d946beee57158dbd89d0e62b91bca0fa2c5f3531"
gradle_root="$project_dir/.deps/gradle"
gradle_home="$gradle_root/gradle-$gradle_version"

if [ ! -x "$gradle_home/bin/gradle" ]; then
    mkdir -p "$gradle_root"
    archive="$gradle_root/gradle-$gradle_version-bin.zip"
    if [ ! -f "$archive" ]; then
        temp_archive=$(mktemp "$gradle_root/gradle-download.XXXXXX")
        curl -fL "https://services.gradle.org/distributions/gradle-$gradle_version-bin.zip" -o "$temp_archive"
        mv "$temp_archive" "$archive"
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        actual_sha256=$(sha256sum "$archive" | awk '{print $1}')
    else
        actual_sha256=$(shasum -a 256 "$archive" | awk '{print $1}')
    fi
    if [ "$actual_sha256" != "$gradle_sha256" ]; then
        echo "Gradle 归档校验失败。" >&2
        exit 1
    fi
    unzip -q "$archive" -d "$gradle_root"
fi

exec "$gradle_home/bin/gradle" "$@"
